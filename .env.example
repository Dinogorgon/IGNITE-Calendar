# Copy this file to ".env" and fill it in. .env is git-ignored, so it never gets pushed.

# Slack blurbs (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Officer login, for local testing with: node dev-server.js
# (on the live site these same names go in Vercel → Settings → Environment Variables)
RESEND_API_KEY=
SESSION_SECRET=
ADMIN_EMAILS=peyton.decker@ufl.edu
# Leave MAIL_FROM blank to use Resend's test sender, which only delivers to the
# email your Resend account was created with. After verifying a domain in Resend:
# MAIL_FROM=IGNITE Events <login@peytondecker.me>
MAIL_FROM=
